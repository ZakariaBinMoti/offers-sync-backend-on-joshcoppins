# Your Shopify store's .myshopify.com domain (not your custom domain)
SHOPIFY_STORE_DOMAIN=joshcoppinsmotorcycles.myshopify.com

# Admin API access token from a custom app (see README for how to create one)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The handle of the page to update. For https://joshcoppinsmotorcycles.co.nz/pages/offers
# the handle is "offers"
SHOPIFY_PAGE_HANDLE=offers

# A random secret string you make up yourself. Used to stop random people
# on the internet from triggering your sync endpoint. Set the same value
# here and in Vercel's project environment variables.
CRON_SECRET=choose-a-long-random-string-here
