# ── Optional: CORS restriction ──────────────────────────────────────────────
# Restrict which domain can call /api/offers from a browser.
# Default is '*' (any origin). Set this to your Shopify storefront domain to
# lock it down once you know the deployment URL.
# ALLOWED_ORIGIN=https://joshcoppinsmotorcycles.co.nz

# ── Optional: ScraperAPI proxy (Yamaha IP-block workaround) ──────────────────
# If Yamaha's WAF blocks Vercel's datacenter IPs (resulting in an empty
# `yamaha` array), add your ScraperAPI key here.
#
# Sign up free at https://www.scraperapi.com — the free tier gives you
# 1,000 requests/month, which is more than enough for a once-daily cron scrape.
#
# When this key is set, scrapeYamaha() will fall back to routing its request
# through ScraperAPI (residential IPs, country_code=nz) if the direct fetch
# returns zero offer cards.
#
# Leave unset if the direct fetch works fine — the proxy is never called unless
# needed, so no credits are wasted.
# SCRAPER_API_KEY=your_scraperapi_key_here
